# Copy to .env and add a Gemini API key from Google AI Studio.
GOOGLE_API_KEY=
# Optional: set both values for hosted Unstructured Partition API parsing.
# A Transform MCP/web URL is not a Partition API URL.
# Standard endpoint: https://api.unstructuredapp.io/general/v0/general
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=

# Optional model overrides.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
TOP_K=5
RETRIEVAL_CANDIDATES=20
QUERY_DECOMPOSITION_ENABLED=true
MAX_SUBQUERIES=3
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
